# www — основной вход (сертификат уже есть)
www.xn--80aaakgo7a.xn--p1ai {
	reverse_proxy app:3000
}

# Корень: только HTTP-редирект на www.
# Без TLS — иначе Caddy долбит Let's Encrypt, пока у @ нет A-записи.
http://xn--80aaakgo7a.xn--p1ai {
	redir https://www.xn--80aaakgo7a.xn--p1ai{uri} permanent
}
