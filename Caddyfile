	reverse_proxy app:3000
}

# Корень без TLS: иначе Caddy долбит Let's Encrypt без A-записи @
http://xn--80aaakgo7a.xn--p1ai {
	redir https://www.xn--80aaakgo7a.xn--p1ai{uri} permanent
}
